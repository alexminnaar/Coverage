# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here
OPENAI_IMAGE_MODEL=gpt-image-2

# Cloudflare R2 storyboard image storage
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=coverage-storyboards
# Public custom domain or R2.dev URL for the bucket (no trailing slash)
R2_PUBLIC_BASE_URL=https://storyboards.example.com

# Server Port (default: 3002 for testing alongside Node.js)
PORT=3002
